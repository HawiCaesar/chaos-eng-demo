# Hotel Chaos Simulator — environment reference
#
# Do not copy this file to `.env` at the repo root for day-to-day dev.
# Each app loads its own `.env` from its package directory:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
#
# Convention:
#   - API: never read process.env in app code — use `env` from apps/api/src/env.ts
#     (backed by parseEnv() from @hotel-chaos/shared).
#   - Web: only import.meta.env.VITE_* in frontend code (see apps/web/src/vite-env.d.ts).

# --- API (apps/api) — parsed by @hotel-chaos/shared ---

# NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Milestone 2 — primary Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Milestone 3 — audit Postgres
# AUDIT_DATABASE_URL=postgresql://user:pass@host:5432/audit

# Shared interview-demo secret (minimum 16 characters). Never expose as VITE_*.
# DEMO_ACCESS_TOKEN=

# Railway GraphQL client and chaos orchestration (required for API boot)
# Account token — never commit. See docs/railway.md
# RAILWAY_API_TOKEN=
# Project / environment / primary Postgres service IDs — see docs/railway.md#ids-and-urls
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_PRIMARY_DB_SERVICE_ID=

# Milestone 5 — chaos control dashboard; audit Postgres + booking-api service IDs
# see docs/railway.md#ids-and-urls (required for API boot in M5)
# RAILWAY_AUDIT_DB_SERVICE_ID=
# RAILWAY_API_SERVICE_ID=

# --- Web (apps/web) — Vite exposes only VITE_* to the browser ---

VITE_API_URL=http://localhost:3001
