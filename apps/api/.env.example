# Local API config — copy to apps/api/.env (not apps/api/src/.env)
# Full variable list: ../../.env.example

PORT=3001
WEB_ORIGIN=http://localhost:5173

# Railway primary Postgres → Variables tab (DATABASE_PUBLIC_URL for local dev from your machine)
DATABASE_URL=postgresql://user:pass@host:port/railway

# Railway audit Postgres (second database) — DATABASE_PUBLIC_URL for local dev
AUDIT_DATABASE_URL=postgresql://user:pass@host:port/railway

# Milestone 4 — Railway GraphQL client (optional until M5 routes; required for npm run railway:smoke)
# Real IDs: docs/railway.md#ids-and-urls — never commit RAILWAY_API_TOKEN
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_PRIMARY_DB_SERVICE_ID=

# Milestone 5 — chaos control dashboard; audit Postgres + booking-api service IDs
# Real IDs: docs/railway.md#ids-and-urls
# RAILWAY_AUDIT_DB_SERVICE_ID=
# RAILWAY_API_SERVICE_ID=
